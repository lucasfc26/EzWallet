# Copy this file to .env before running `docker compose up`.
# docker-compose.yml reads these variables to bootstrap Postgres and to
# configure the backend/frontend containers.

# --- Postgres (private Docker network only; not published on the host) ---
POSTGRES_DB=ezwallet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser
# Schema-owner role used only by Prisma Migrate:
POSTGRES_OWNER_USER=ezwallet_owner
POSTGRES_OWNER_PASSWORD=change_me_owner
# Runtime role used by the API. RLS-restricted, never a table owner:
POSTGRES_APP_USER=ezwallet_app
POSTGRES_APP_PASSWORD=change_me_app

# --- Backend (private Docker network only; reached via frontend /api) ---
ACCESS_TOKEN_SECRET=change_me_access_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true

# --- Frontend (only service published on the host; loopback only on VPS) ---
# Host scan 2026-09-18: 80/443 = nginx (other server_names), 22, 9000, 3001,
# 3478, 40000-40049 public; 8081-8085 / 18080-18083 / 5432-5435 loopback.
# 27118 is free. Do not bind 80/443 — use deploy/ezwallet.maselcorp.com.br.conf.
#
# Local Docker (laptop): FRONTEND_BIND=0.0.0.0 FRONTEND_PORT=8080
#   FRONTEND_ORIGIN=http://localhost:8080 COOKIE_SECURE=false
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=27118
FRONTEND_ORIGIN=https://ezwallet.maselcorp.com.br
