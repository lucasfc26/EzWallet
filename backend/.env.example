# --- Postgres server (used by docker-compose to bootstrap the database) ---
POSTGRES_DB=ezwallet
POSTGRES_OWNER_USER=ezwallet_owner
POSTGRES_OWNER_PASSWORD=change_me_owner
POSTGRES_APP_USER=ezwallet_app
POSTGRES_APP_PASSWORD=change_me_app

# --- Prisma connections ---
# Runtime role: owns NO tables, only granted DML -> every query is subject to RLS.
DATABASE_URL="postgresql://ezwallet_app:change_me_app@localhost:5432/ezwallet?schema=public"
# Migration role: owns the schema -> used only by `prisma migrate`/`prisma db push`.
# Table owners bypass RLS, which is exactly why the app must NEVER connect with this role.
MIGRATE_DATABASE_URL="postgresql://ezwallet_owner:change_me_owner@localhost:5432/ezwallet?schema=public"

# --- Auth ---
ACCESS_TOKEN_SECRET=change_me_access_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret
REFRESH_TOKEN_TTL_DAYS=7

# --- App ---
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
