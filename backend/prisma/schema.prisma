generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime role (RLS-restricted). See MIGRATE_DATABASE_URL below for the schema-owner role.
  url       = env("DATABASE_URL")
  // Schema-owner role, used only for `prisma migrate` / `prisma db push`.
  directUrl = env("MIGRATE_DATABASE_URL")
}

/// Application user / account. Owns every Expense, Income and Charge row.
model User {
  id                     String   @id @default(uuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  monthlySpendCap        Int?     @map("monthly_spend_cap")
  defaultCategoryId      String?  @map("default_category_id")
  defaultPaymentOptionId String?  @map("default_payment_option_id")
  defaultPaymentCardId   String?  @map("default_payment_card_id")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  expenses       Expense[]
  incomes        Income[]
  charges        Charge[]
  refreshTokens  RefreshToken[]
  categories     Category[]
  paymentCards   PaymentCard[]
  paymentOptions PaymentOption[]

  @@map("users")
}

/// Opaque refresh tokens are never stored in plain text — only a hash, so a DB
/// leak alone can't be replayed. Enables logout / rotation / revocation.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum ExpenseStatus {
  paid
  pending
}

enum IncomeStatus {
  received
  pending
}

enum ChargeStatus {
  pending
  received
  canceled
}

enum Recurrence {
  none
  weekly
  monthly
  yearly
}

enum PaymentMethod {
  pix
  debit
  credit
  cash
  boleto
  transfer
}

enum CategoryKind {
  expense
  income
}

enum CardBrand {
  visa
  mastercard
  elo
  amex
  hipercard
  other
}

enum CardKind {
  credit
  debit
}

model Category {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String?
  name      String
  kind      CategoryKind
  icon      String
  color     String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  expenses Expense[]
  incomes  Income[]

  @@unique([userId, slug])
  @@index([userId, kind])
  @@map("categories")
}

model PaymentCard {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     CardBrand
  last4     String    @map("last4") @db.Char(4)
  kind      CardKind  @default(credit)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  expenses Expense[]

  @@index([userId])
  @@map("payment_cards")
}

/// Per-user copy of the default payment methods (Pix, boleto, etc).
/// Editing or deleting a row never affects another account.
model PaymentOption {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String?
  name      String
  method    PaymentMethod
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  expenses Expense[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("payment_options")
}

/// categoryId is a free string validated at the DTO layer against the same
/// taxonomy defined in frontend/src/data/categories.ts (see ROADMAP.md) —
/// icons/colors are a UI concern and stay owned by the frontend.
model Expense {
  id            String        @id @default(uuid())
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  description       String
  amount            Int
  date              DateTime      @db.Date
  categoryId        String        @map("category_id")
  category          Category      @relation(fields: [categoryId], references: [id])
  paymentMethod     PaymentMethod @map("payment_method")
  paymentCardId     String?       @map("payment_card_id")
  paymentCard       PaymentCard?  @relation(fields: [paymentCardId], references: [id], onDelete: SetNull)
  paymentOptionId   String?       @map("payment_option_id")
  paymentOption     PaymentOption? @relation(fields: [paymentOptionId], references: [id], onDelete: SetNull)
  status            ExpenseStatus
  dueDate           DateTime?     @map("due_date") @db.Date
  notes             String?
  recurrence        Recurrence    @default(none)
  recurrenceCount   Int           @default(1) @map("recurrence_count")
  recurrenceGroupId String?       @map("recurrence_group_id")
  recurrenceIndex   Int           @default(1) @map("recurrence_index")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("expenses")
}

model Income {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Int
  date        DateTime     @db.Date
  categoryId  String       @map("category_id")
  category    Category     @relation(fields: [categoryId], references: [id])
  status      IncomeStatus
  chargeId    String?      @unique @map("charge_id")
  charge      Charge?      @relation(fields: [chargeId], references: [id])
  notes       String?
  recurrence  Recurrence   @default(none)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("incomes")
}

model Charge {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName  String       @map("client_name")
  description String
  amount      Int
  dueDate     DateTime     @map("due_date") @db.Date
  status      ChargeStatus
  receivedAt  DateTime?    @map("received_at") @db.Date
  notes       String?
  recurrence  Recurrence   @default(none)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  settledIncome Income?

  @@index([userId, dueDate])
  @@map("charges")
}
